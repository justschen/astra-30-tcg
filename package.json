  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/justschen/astra-30-tcg/issues"
  },
  "homepage": "https://justschen.github.io/astra-30-tcg/",
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "delaunator": "^5.1.0",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "three": "^0.186.1"
  },
  "private": true
