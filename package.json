{
  "name": "astra-30-tcg",
  "version": "1.0.0",
  "description": "Afterhours: an interactive TCG binder in a living Tokyo collector room",
  "scripts": {
    "build": "node binder/build.mjs",
    "test": "npm run build && npm run test:binder",
    "dev": "node binder/build.mjs --serve",
    "build:binder": "node binder/build.mjs",
    "test:binder": "node --test binder/tests/*.test.mjs",
    "test:binder:browser": "node binder/tests/browser.mjs",
    "audit:binder:performance": "node binder/tests/performance-browser.mjs",
    "assets:binder": "node binder/fetch-assets.mjs",
    "assets:binder:room": "node binder/fetch-room-assets.mjs",
    "assets:binder:plants": "node binder/fetch-plant-assets.mjs",
    "assets:binder:city": "node binder/fetch-city-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justschen/astra-30-tcg.git"
  },
  "keywords": [],
